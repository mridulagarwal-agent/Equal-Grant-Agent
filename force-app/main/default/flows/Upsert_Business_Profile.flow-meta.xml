<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Upserts a Small Business Account profile from Agentforce intake answers. Callable action.</description>
    <environments>Default</environments>
    <interviewLabel>Upsert Business Profile {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Upsert Business Profile</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <status>Active</status>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Load_Account</targetReference>
        </connector>
    </start>

    <variables>
        <name>inputAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputBusinessName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputNaics</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputKeywords</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputState</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputRevenueBand</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputBusinessStage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputMinorityOwned</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputWomanOwned</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputVeteranOwned</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputSamUei</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>outputAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>outputProfileComplete</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varExistingAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>

    <formulas>
        <name>fxBusinessName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!inputBusinessName}), "New Small Business (profile in progress)", {!inputBusinessName})</expression>
    </formulas>

    <recordLookups>
        <name>Load_Account</name>
        <label>Load Existing Account</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Existing_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputAccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <outputReference>varExistingAccount</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Reload_After_Update</name>
        <label>Reload After Update (for Profile_Complete)</label>
        <locationX>50</locationX>
        <locationY>480</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Output_From_Existing</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varExistingAccount.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <outputReference>varExistingAccount</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Profile_Complete__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Reload_New</name>
        <label>Reload New Account (for Profile_Complete)</label>
        <locationX>302</locationX>
        <locationY>600</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Output_Complete_From_New</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>outputAccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <outputReference>varExistingAccount</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Profile_Complete__c</queriedFields>
    </recordLookups>

    <decisions>
        <name>Has_Existing_Account</name>
        <label>Has Existing Account</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Create_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Create New</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingAccount.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account</targetReference>
            </connector>
            <label>Update Existing</label>
        </rules>
    </decisions>

    <recordUpdates>
        <name>Update_Account</name>
        <label>Update Existing Account</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Reload_After_Update</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varExistingAccount.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>NAICS_Code__c</field>
            <value>
                <elementReference>inputNaics</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Industry_Keywords__c</field>
            <value>
                <elementReference>inputKeywords</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Operating_State__c</field>
            <value>
                <elementReference>inputState</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Revenue_Band__c</field>
            <value>
                <elementReference>inputRevenueBand</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Business_Stage__c</field>
            <value>
                <elementReference>inputBusinessStage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Minority_Owned__c</field>
            <value>
                <elementReference>inputMinorityOwned</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Woman_Owned__c</field>
            <value>
                <elementReference>inputWomanOwned</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Veteran_Owned__c</field>
            <value>
                <elementReference>inputVeteranOwned</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SAM_UEI__c</field>
            <value>
                <elementReference>inputSamUei</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>

    <recordCreates>
        <name>Create_Account</name>
        <label>Create New Account</label>
        <locationX>302</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Set_Output_From_New</targetReference>
        </connector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>fxBusinessName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NAICS_Code__c</field>
            <value>
                <elementReference>inputNaics</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Industry_Keywords__c</field>
            <value>
                <elementReference>inputKeywords</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Operating_State__c</field>
            <value>
                <elementReference>inputState</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Revenue_Band__c</field>
            <value>
                <elementReference>inputRevenueBand</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Business_Stage__c</field>
            <value>
                <elementReference>inputBusinessStage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Minority_Owned__c</field>
            <value>
                <elementReference>inputMinorityOwned</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Woman_Owned__c</field>
            <value>
                <elementReference>inputWomanOwned</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Veteran_Owned__c</field>
            <value>
                <elementReference>inputVeteranOwned</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SAM_UEI__c</field>
            <value>
                <elementReference>inputSamUei</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <assignments>
        <name>Set_Output_From_Existing</name>
        <label>Set Output (Existing)</label>
        <locationX>50</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>outputAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varExistingAccount.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outputProfileComplete</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varExistingAccount.Profile_Complete__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Output_From_New</name>
        <label>Set Output (New)</label>
        <locationX>302</locationX>
        <locationY>480</locationY>
        <connector>
            <targetReference>Reload_New</targetReference>
        </connector>
        <assignmentItems>
            <assignToReference>outputAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Account</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Output_Complete_From_New</name>
        <label>Set Profile Complete (New)</label>
        <locationX>302</locationX>
        <locationY>720</locationY>
        <assignmentItems>
            <assignToReference>outputProfileComplete</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varExistingAccount.Profile_Complete__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
</Flow>

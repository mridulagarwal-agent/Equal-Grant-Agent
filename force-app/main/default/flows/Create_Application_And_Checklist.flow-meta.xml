    <formulas>
        <name>fxTargetDeadline</name>
        <dataType>Date</dataType>
        <expression>{!varGrant.Close_Date__c} - 7</expression>
    </formulas>

    <decisions>
        <name>Grant_Found</name>
        <label>Grant Found and Account Present</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>Set_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Missing prerequisites</defaultConnectorLabel>
        <rules>
            <name>Ready</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varGrant.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputAccountId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Application</targetReference>
            </connector>
            <label>Ready</label>
        </rules>
    </decisions>

    <recordLookups>
        <name>Load_Grant</name>
        <label>Load Grant Opportunity (by Id or Number)</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Grant_Found</targetReference>
        </connector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputGrantOpportunityId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Opportunity_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputGrantOpportunityNumber</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Grant_Opportunity__c</object>
        <outputReference>varGrant</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Close_Date__c</queriedFields>
    </recordLookups>

